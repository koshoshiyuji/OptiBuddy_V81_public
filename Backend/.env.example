# Optibuddy バックエンド 環境変数設定
# このファイルをコピーして .env を作成し、実際の値を設定してください。
# cp .env.example .env

# ==== CPLEX設定 ====
CPLEX_PATH=""
# 2026-09-29: 旧表記 CPOTPIMIZER_PATH（綴り誤り、どのコードからも読まれていなかった）を修正。
# cpoptimizer実行ファイルの絶対パス。通常は空欄でよい（PATH上、または実行中のPythonと同じ
# binフォルダ＝requirements-cplex.txtでvenvに入ったものを自動で探す。
# solvers/base/engine_availability.py）。見つからない場所にある場合のみ指定する。
CPOPTIMIZER_PATH=""
TimeLimit= 20
LogPeriod= 10000
# 正規ライセンスなら1、コミュニティライセンスなら0
CPLEX_LICENSED=0
# DECOMPOSER_WORKERS= 未設定ならコア数
# DECOMPOSER_LOG_EVOLが"1"設定されている場合のみ書き込む（デフォルト OFF）
# 2026-07-20修正: コメントは「デフォルトOFF」なのに値が"1"（ON）になっていたバグを修正
DECOMPOSER_LOG_EVOL="0"
# DECOMPOSER_SKIPが"1"に設定されている場合、Decomposerはスキップされる（デフォルト OFF）
DECOMPOSER_SKIP="0"

# ==== ソルバーバックエンド（2026-09-29、DEFAULT_SOLVER_ENGINEから統一）====
# solvers/base/engine_select.py の get_solver_backend() が参照する。
#   "oss"  : CP=OR-Tools CP-SAT（CPMpy経由）、MIP=SCIP（OR-Tools同梱）。既定。
#            requirements.txt だけで動く。
#   "cplex": CP=CPLEX CP Optimizer、MIP=CPLEX。requirements-cplex.txt が必要
#            （Community Editionで可。MIPはCE上限を超えるとSCIPへ自動で切り替え）。
# ドメイン単位の config.solver_engine（CP）が指定されていればそちらが優先。
# 旧設定 DEFAULT_SOLVER_ENGINE（cpsat/cpo）は SOLVER_BACKEND が未設定のときだけ
# 互換として読む（cpsat→oss、cpo→cplex）。両方あって食い違う場合は SOLVER_BACKEND
# を優先し警告ログを出すため、旧設定の行は削除すること。
# 例外: Yardはdecomposer前提のカスタムメイドかつCP-SATエンジンを持たないため、
# この設定に関わらずCPLEX(CE)を使う（2026-08-13時点）。
SOLVER_BACKEND=oss

# ==== APIキー認証（2026-08-21追加、任意）====
# /baseline 等のAPIエンドポイントに簡易なAPIキー認証をかけたい場合に設定する。
# 空欄（未設定）のままなら、従来通り認証なしで動作する（開発・検証用途はこれでよい）。
# 値を設定すると、/health を除く全エンドポイントで
# X-API-Key ヘッダー（または Authorization: Bearer <key>）による一致が必須になる。
# 顧客先へ導入・外部公開する場合は、ランダムな文字列
# （例: `openssl rand -hex 32` で生成）を設定することを推奨する。
#
# キーは1つでよい場合はこちら（後方互換の単純な方式）。
OPTIBUDDY_API_KEY=
#
# 同じ環境内で複数の呼び出し元（自社フロントエンド・ERP連携・夜間バッチ等）を
# 名前で区別したい場合は、OPTIBUDDY_API_KEY の代わりにこちらをJSON形式で設定する
# （両方設定した場合はOPTIBUDDY_API_KEYSが優先され、OPTIBUDDY_API_KEYは無視される）。
# 特定の呼び出し元だけキーを無効化したい場合は、該当行を削除して再起動すればよい。
# 例:
# OPTIBUDDY_API_KEYS={"frontend": "xxxxxxxx", "batch_job": "yyyyyyyy"}
OPTIBUDDY_API_KEYS=

# ==== ドメイン進化履歴ログ（dsl_evolution_log）====
# Q&A回答内容・選択したプランなど、ユーザーのアクティビティを記録する機能。
# 0を指定すると記録自体を無効化する（デフォルトは有効=1）。
# 開発環境ではそのままでよい。顧客配布パッケージでは 0 を設定すること
# （権利・セキュリティ上、顧客環境の活動履歴を自動収集しない方針。
# デバッグに必要な場合は都度ユーザーから内容の提供をお願いする）。
EVOLUTION_LOG_ENABLED="1"

# ==== FLASK設定 ====
FLASK_APP=api/app_v4.py

# ==== LLM設定 ====
# 使用するプロバイダーをここで指定（未設定時のコード側デフォルトも anthropic。
# 2026-07-20修正: 従来ここにLLM_PROVIDER自体の記載が無く、各プロバイダーの
# コメント例にしか登場しない「記載漏れ」だったため明示行を追加）。
LLM_PROVIDER=anthropic
# どれか1つを選択
# Anthropic に切り替える場合
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_HAIKU_MODEL=

# OpenAI に切り替える場合
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=
# OPENAI_MINI_MODEL=

# Gemini に切り替える場合
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_FLASH_MODEL=

# ==== Gantt表示設定 ====
GANTT_BAR_HEIGHT=20
GANTT_BAR_GAP=6
GANTT_SCALE=50

# ==== LLM提案設定 ====
DEFAULT_MAX_LLM_SUGGESTIONS=3

# ==== ソリューション保存先 ====
SOLUTIONS_FOLDER=solutions

