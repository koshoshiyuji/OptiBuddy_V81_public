# Optibuddy バックエンド 環境変数設定（顧客配布用テンプレート）
#
# 開発用の .env.example との違いはこの1点のみ：
#   EVOLUTION_LOG_ENABLED の既定値が 0（無効）になっている。
# それ以外の項目・既定値・コメントは .env.example と同一に保つこと
# （2026-07-20 HANDOFF 3-1: 顧客配布用.envテンプレートとして新規作成。
#  差分管理を容易にするため、意図的に構成を .env.example と揃えている）。
#
# このファイルをコピーして .env を作成し、実際の値を設定してください。
# cp .env.customer.example .env

# ==== CPLEX設定 ====
# 顧客環境のCPLEX/CP Optimizerインストールパスを指定（配布時点では空欄のまま渡す）。
CPLEX_PATH=""
CPOTPIMIZER_PATH=""
TimeLimit= 20
LogPeriod= 10000
# 正規ライセンスなら1、コミュニティライセンスなら0
CPLEX_LICENSED=0
# DECOMPOSER_WORKERS= 未設定ならコア数
# DECOMPOSER_LOG_EVOLが"1"設定されている場合のみ書き込む（デフォルト OFF）
DECOMPOSER_LOG_EVOL="0"
# DECOMPOSER_SKIPが"1"に設定されている場合、Decomposerはスキップされる（デフォルト OFF）
DECOMPOSER_SKIP="0"

# ==== CP側ソルバーエンジン既定値（2026-08-13追加）====
# solvers/base/engine_select.py が参照する。CP系ドメイン（docplex.cp使用）で
# config.solver_engine が明示指定されていない場合のデプロイ環境単位の既定値。
# "cpsat" (Google OR-Tools CP-SAT, CPMpy経由) または "cpo" (CPLEX CP Optimizer)>。
# 未設定時のコード側最終フォールバックは "cpsat"（CPLEXが無い環境でも動くことを>優先）。
# CPLEX CE/正規ライセンスをデプロイ環境の既定にしたい場合は "cpo" を設定する。
# 例外: Yardのみdecomposer前提のカスタムメイドかつCP-SATエンジンを持たないため、
# この設定に関わらず既定はCPLEX(CE)のまま（2026-08-13時点、NurseShiftWeeklyCap・
# TruckDispatcherは他ドメインと同じconfig.solver_engine機構に統一済みのため
# この例外から外れた）。
DEFAULT_SOLVER_ENGINE=cpsat

# ==== APIキー認証（2026-08-21追加、任意）====
# /baseline 等のAPIエンドポイントに簡易なAPIキー認証をかけたい場合に設定する。
# 空欄（未設定）のままだと認証なしで動作する。
# 【顧客配布時は設定を強く推奨】このテンプレートはお客様先での本番導入を
# 想定しているため、配布前にランダムな文字列（例: `openssl rand -hex 32`）を
# 生成して値を埋めることを推奨する。設定すると、/health を除く全エンドポイントで
# X-API-Key ヘッダー（または Authorization: Bearer <key>）による一致が必須になる。
OPTIBUDDY_API_KEY=

# ==== ドメイン進化履歴ログ（dsl_evolution_log）====
# Q&A回答内容・選択したプランなど、ユーザーのアクティビティを記録する機能。
# 0を指定すると記録自体を無効化する（開発環境での既定は有効=1）。
# 顧客配布パッケージでは 0 が既定（権利・セキュリティ上、顧客環境の活動履歴を
# 自動収集しない方針のため。デバッグに必要な場合は都度ユーザーから内容の
# 提供をお願いする）。このテンプレートでは変更しないこと。
EVOLUTION_LOG_ENABLED=0

# ==== FLASK設定 ====
FLASK_APP=api/app_v4.py

# ==== LLM設定 ====
# 使用するプロバイダーをここで指定（未設定時のコード側デフォルトも anthropic）。
LLM_PROVIDER=anthropic
# どれか1つを選択
# Anthropic に切り替える場合
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
ANTHROPIC_HAIKU_MODEL=

# OpenAI に切り替える場合
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=
# OPENAI_MINI_MODEL=

# Gemini に切り替える場合
# LLM_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=
# GEMINI_FLASH_MODEL=

# ==== Gantt表示設定 ====
GANTT_BAR_HEIGHT=20
GANTT_BAR_GAP=6
GANTT_SCALE=50

# ==== LLM提案設定 ====
DEFAULT_MAX_LLM_SUGGESTIONS=3

# ==== ソリューション保存先 ====
SOLUTIONS_FOLDER=solutions
